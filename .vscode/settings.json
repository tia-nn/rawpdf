{
  // lixのシムを使う（.haxercの版とhaxe_libraries/のライブラリが使われる）。PATH上の別のhaxeを避けるため
  "haxe.executable": "node_modules/.bin/haxe",
  // 補完・エラー表示には、全パッケージをまとめたルートのdisplay.hxmlを使う（意図はdisplay.hxmlの冒頭）。
  // ルート直下の*.hxmlは自動検出もされるが、ほかのhxmlが増えても選ばれないよう明示する。
  // パッケージを作ったら、ここではなくdisplay.hxmlに足す
  "haxe.configurations": [
    {
      "label": "display",
      "args": [
        "display.hxml"
      ]
    }
  ],
  // haxe-language-serverは保存時にしかエラー表示（診断）を更新しないため、
  // Haxeファイルだけ、手が止まってから少しすると自動で保存されるようにする
  "[haxe]": {
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 800,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // haxe-checkstyle拡張は、ワークスペースルートからのパスがsourceFoldersで始まるファイルだけを検査する
  // （既定は["src", "Source"]）。コードはpackages/以下にあるので指定する。
  // 設定はファイルから親へたどって見つけたcheckstyle.json（ルートのもの）が使われる。検査は開いたとき・保存したとき
  "haxecheckstyle.sourceFolders": [
    "packages"
  ],
  "cSpell.words": [
    "Endobj",
    "Endstream",
    "Haxe",
    "haxelib",
    "hxml",
    "hxnodejs",
    "rawpdf",
    "Startxref",
    "utest"
  ]
}
